<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- Lets the reading-session Live Activity run: without this the
	     system refuses ActivityKit requests outright. See
	     ios/Runner/ReadingSessionController.swift. -->
		<key>NSSupportsLiveActivities</key>
		<true/>
		<key>CFBundleDisplayName</key>
		<string>JW Streak</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<!-- Alternate launcher icons (settings → App icon). iOS only lets
		     setAlternateIconName use names declared here, so every key must
		     match an AppIcon-*.appiconset in Assets.xcassets, the
		     ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES build setting, and
		     the iosAlternateName values in lib/services/app_icon_service.dart. -->
		<key>CFBundleIcons</key>
		<dict>
			<key>CFBundlePrimaryIcon</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIcon</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>CFBundleAlternateIcons</key>
			<dict>
				<key>AppIcon-GlobalLove</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-GlobalLove</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-Alpine</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-Alpine</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-Minimalist</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-Minimalist</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-Modern</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-Modern</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-SmallHand</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-SmallHand</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-WhiteLake</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-WhiteLake</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<key>CFBundleIcons~ipad</key>
		<dict>
			<key>CFBundlePrimaryIcon</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>AppIcon</string>
				</array>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<key>CFBundleAlternateIcons</key>
			<dict>
				<key>AppIcon-GlobalLove</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-GlobalLove</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-Alpine</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-Alpine</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-Minimalist</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-Minimalist</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-Modern</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-Modern</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-SmallHand</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-SmallHand</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
				<key>AppIcon-WhiteLake</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIcon-WhiteLake</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<!-- iOS only offers Flutter the device languages an app claims to speak:
		     without this list it reports just CFBundleDevelopmentRegion, so
		     _resolveLocale() in main.dart would see ["en"] on a French iPhone and
		     open in English. Keep in sync with the .arb files in lib/l10n. -->
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>de</string>
			<string>es</string>
			<string>fr</string>
			<string>it</string>
			<string>pl</string>
			<string>pt</string>
			<string>ru</string>
			<string>zh</string>
		</array>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>JW Streak</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- The app only ever calls out over standard HTTPS (url_launcher
		     opening jw.org / JW Library) — no custom or proprietary
		     encryption. Declaring this here skips the encryption-compliance
		     question App Store Connect otherwise asks on every single
		     upload. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- iOS hides other apps' URL schemes unless they're declared here: without
	     this, canLaunchUrl('jwlibrary://') always returns false and the app
	     would think JW Library is never installed, silently falling back to
	     the website for every passage. The Android equivalent is the
	     <queries> block in AndroidManifest.xml. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>jwlibrary</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- Required by iOS as soon as the binary links LocalAuthentication (the
	     local_auth plugin, used by the optional app lock). iOS terminates the
	     app on the first Face ID call if this string is missing, even when the
	     user never turns the lock on. -->
		<key>NSFaceIDUsageDescription</key>
		<string>Face ID unlocks JW Streak when you turn on the optional app lock in Settings.</string>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
